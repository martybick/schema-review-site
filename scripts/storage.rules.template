rules_version = '2';

// NOTE: generated by scripts/buildRules.js from config/members.json and
// scripts/storage.rules.template. Edit those, then run `npm run rules`.
//
// Storage for the schema review site:
// - Only invited people (admins and users) can read anything.
// - Release packages and bulk corpora are written only by admins.
// - Each user may upload XML to their own contributions folder.
// - config/admin-check and config/member-check never exist: the app reads
//   them to learn a person's role from whether the read is allowed.
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn () {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function isAdmin () {
      return isSignedIn() && request.auth.token.email.lower() in __ADMINS__;
    }

    function isMember () {
      return isAdmin() || (isSignedIn() && request.auth.token.email.lower() in __USERS__);
    }

    match /config/admin-check {
      allow read: if isAdmin();
    }

    match /config/member-check {
      allow read: if isMember();
    }

    match /packages/{allPaths=**} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /corpora/{allPaths=**} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /contributions/{userID}/{allPaths=**} {
      allow read: if isMember() && (request.auth.uid == userID || isAdmin());
      allow create, update: if isMember() && request.auth.uid == userID
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('(application|text)/xml');
      allow delete: if isMember() && (request.auth.uid == userID || isAdmin());
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

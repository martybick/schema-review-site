rules_version = '2';

// NOTE: generated by scripts/buildRules.js from config/members.json and
// scripts/firestore.rules.template. Edit those, then run `npm run rules`.
//
// The site's database:
// - members/{email}: invited people and their role (admin or user). Admins
//   manage it on the People page. Admins named in config/members.json are
//   owners: they always have access, so the site can never be locked out.
// - comments/{id}: comments on constructs and decisions. Anyone invited may
//   comment; only the author or an admin may delete; only admins set status.
// - positions/{decisionKey}__{email}: one position per person per decision,
//   changeable until the working group's decision is recorded.
// - decisionRecords/{decisionKey}: the working group's recorded outcome, and
//   decisionEvents/{id}: every recording, kept as history. Admins only.
// - siteSettings/{project}: the release the site opens on and the releases
//   hidden from members. Admins only.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn () {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function myEmail () {
      return request.auth.token.email.lower();
    }

    function isOwner () {
      return isSignedIn() && myEmail() in __ADMINS__;
    }

    function isListed () {
      return isSignedIn() && exists(/databases/$(database)/documents/members/$(myEmail()));
    }

    function isAdmin () {
      return isOwner()
        || (isListed() && get(/databases/$(database)/documents/members/$(myEmail())).data.role == 'admin');
    }

    function isMember () {
      return isAdmin() || isListed() || (isSignedIn() && myEmail() in __USERS__);
    }

    function isSettled (decisionKey) {
      return exists(/databases/$(database)/documents/decisionRecords/$(decisionKey))
        && get(/databases/$(database)/documents/decisionRecords/$(decisionKey)).data.status in ['ratified', 'changed'];
    }

    match /members/{memberEmail} {
      allow read: if isMember();
      allow create, update: if isAdmin()
        && memberEmail == memberEmail.lower()
        && request.resource.data.keys().hasOnly(['email', 'role', 'addedBy', 'addedAt', 'updatedBy', 'updatedAt'])
        && request.resource.data.email == memberEmail
        && request.resource.data.role in ['admin', 'user'];
      allow delete: if isAdmin() && memberEmail != myEmail();
    }

    match /comments/{commentID} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['target', 'project', 'release', 'targetKind', 'targetKey', 'type', 'body', 'authorEmail', 'authorName', 'createdAt', 'status', 'parentID'])
        && request.resource.data.authorEmail == myEmail()
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'open'
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 10000
        && request.resource.data.type in ['defect', 'gap', 'naming', 'documentation', 'alternative', 'question', 'editorial', 'reply'];
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusBy', 'statusAt'])
        && request.resource.data.status in ['open', 'accepted', 'rejected', 'deferred', 'addressed'];
      allow delete: if isAdmin() || (isMember() && resource.data.authorEmail == myEmail());
    }

    match /positions/{positionID} {
      allow read: if isMember();
      allow create, update: if isMember()
        && positionID == request.resource.data.decisionKey + '__' + myEmail()
        && request.resource.data.keys().hasOnly(['decisionKey', 'project', 'email', 'name', 'position', 'reason', 'updatedAt'])
        && request.resource.data.email == myEmail()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.position in ['support', 'oppose', 'abstain']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 2000
        && !isSettled(request.resource.data.decisionKey);
      allow delete: if isMember() && resource.data.email == myEmail() && !isSettled(resource.data.decisionKey);
    }

    // NOTE: which release the site opens on and which releases members see.
    match /siteSettings/{project} {
      allow read: if isMember();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['defaultRelease', 'hiddenReleases', 'updatedBy', 'updatedAt'])
        && request.resource.data.hiddenReleases is list
        && request.resource.data.updatedBy == myEmail()
        && request.resource.data.updatedAt == request.time;
    }

    match /decisionRecords/{decisionKey} {
      allow read: if isMember();
      allow write: if isAdmin()
        && request.resource.data.status in ['ratified', 'changed', 'reopened']
        && request.resource.data.recordedBy == myEmail()
        && request.resource.data.recordedAt == request.time;
    }

    match /decisionEvents/{eventID} {
      allow read: if isMember();
      allow create: if isAdmin()
        && request.resource.data.recordedBy == myEmail()
        && request.resource.data.recordedAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
